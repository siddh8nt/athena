{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "description": "Athena: the taste-led growth agent for consumer brands",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre.mjs && next dev",
    "build": "node scripts/copy-maplibre.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "live": "vitest run -c vitest.live.config.ts",
    "seed:demo": "vitest run -c vitest.live.config.ts tests/live/seed-demo.live.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "maplibre-gl": "6.11.2",
    "next": "16.4.3",
    "nodemailer": "^7.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
