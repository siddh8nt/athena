# Copy to .env and fill in. Never commit .env.
QLOO_API_KEY=your-hackathon-key-here
# Optional extra keys: calls rotate across all of them (5 a second each)
QLOO_API_KEY_2=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM (PRD §12.8). Default: Gemini on Vertex AI, paid from the Google Cloud credit.
# Locally, authenticate with: gcloud auth application-default login
LLM_PROVIDER=vertex-gemini
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini answers only on the global endpoint (both models return 404 in us-central1, tested 8 Oct).
# Cloud Run itself still deploys to us-central1.
GOOGLE_CLOUD_LOCATION=global
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# Only if LLM_PROVIDER=anthropic (billed separately, not from the credit)
ANTHROPIC_API_KEY=

# Free enrichment keys (PRD §11.2). Each one is optional; without one, Athena skips that detail quietly.
TICKETMASTER_API_KEY=
CENSUS_API_KEY=

# 1 = serve synthetic FIXTURE data; no keys needed
ATHENA_FIXTURES=0

# Athena's own sending account, for the This week email (PRD §23.6 j). Gmail: smtp.gmail.com, port 465,
# the account's address, and a 16-character app password. Unset, the email controls stay hidden.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The Monday run's bearer secret (app/api/digest/run), and the public URL its emails link back to.
DIGEST_CRON_SECRET=
PUBLIC_URL=
